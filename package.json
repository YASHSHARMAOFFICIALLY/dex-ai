{
  "name": "dex-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' --if-present build",
    "typecheck": "node_modules/@typescript/native/bin/tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "echo e2e placeholder: Playwright arrives with the e2e task"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
